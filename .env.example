# ===========================================================
# Radio Dream — Liquidsoap environment variables
# Copy to .env and fill in the values.
# ===========================================================

# -----------------------------------------------------------
# Icecast connection (REQUIRED: ICECAST_PASSWORD)
# -----------------------------------------------------------
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_USER=source
# Must match <source-password> in icecast.xml. Must not be empty.
ICECAST_PASSWORD=
ICECAST_MOUNT=/radio.mp3

# -----------------------------------------------------------
# Stream info
# -----------------------------------------------------------
ICECAST_NAME="Radio Dream"
ICECAST_GENRE="Rock"
ICECAST_DESCRIPTION="Radio Dream"
ICECAST_URL=

# -----------------------------------------------------------
# Playback
# -----------------------------------------------------------
# A jingle is played after this many tracks (must be > 0)
JINGLE_EVERY=4
# MP3 bitrate in kbps (8-320)
STREAM_BITRATE=128

# -----------------------------------------------------------
# Discogs cover lookup (optional)
# Set BOTH or leave BOTH empty. If empty, no Discogs requests
# are made and the stream URL field stays empty.
# -----------------------------------------------------------
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# -----------------------------------------------------------
# S3 playlist (optional)
# Leave S3_BUCKET empty to use local folders
# (/app/storage/tracks and /app/storage/jingles).
# If S3_BUCKET is set, the access key and secret are required
# and the two prefixes must be different.
# -----------------------------------------------------------
S3_BUCKET=
S3_TRACKS_PREFIX=tracks
S3_JINGLES_PREFIX=jingles
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------
# Misc (optional)
# -----------------------------------------------------------
# Path (inside the container) to a known-good audio file used
# as last-resort fallback. If empty, silence is used.
FALLBACK_FILE=
# Liquidsoap log level (3 = normal, 5 = debug)
LOG_LEVEL=3
